# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored. NEVER commit real keys.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated backups, tried in order if the main model is overloaded (503) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# true = return fixed sample data instead of calling Gemini (no key needed)
MOCK_AI=false

# Port for the Express server (frontend's Vite proxy expects 3001)
PORT=3001

# Allowed browser origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Gemini request timeout in milliseconds
AI_TIMEOUT_MS=60000
