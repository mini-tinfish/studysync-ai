{
  "name": "studysync-server",
  "version": "1.0.0",
  "private": true,
  "description": "StudySync AI backend (Express + Gemini)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "dev:mock": "node --env-file-if-exists=.env --watch src/index.js --mock",
    "test": "node --test tests/",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "unpdf": "^2.2.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
